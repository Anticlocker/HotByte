# ==============================================================================
# HotByte - Server Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual configuration keys.
# ⚠️ CRITICAL: Never commit the '.env' file or actual secret keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Settings
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. CORS & Client Domain Configuration
# ------------------------------------------------------------------------------
# Specifies the allowed client origin for API requests
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotbyte
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Keys
# ------------------------------------------------------------------------------
# Secrets used for encryption, cookies, and verification signatures.
# Ensure these are changed to strong, unique random strings in production!
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here
TRUSTED_CLIENT_KEY=your_trusted_client_key_here

# ------------------------------------------------------------------------------
# 5. Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
# Obtain your credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 6. Message Central OTP (SMS Verification) Configuration
# ------------------------------------------------------------------------------
# Get your API configurations from Message Central dashboard.
MESSAGE_CENTRAL_SEND_OTP_URL=https://cpaas.messagecentral.com/verification/v3/send
MESSAGE_CENTRAL_VALIDATE_OTP_URL=https://cpaas.messagecentral.com/verification/v3/validateOtp
MESSAGE_CENTRAL_COUNTRY_CODE=91
MESSAGE_CENTRAL_CUSTOMER_ID=your_message_central_customer_id_here
MESSAGE_CENTRAL_AUTH_TOKEN=your_message_central_auth_token_here

# ------------------------------------------------------------------------------
# 7. Bunny CDN Configuration (Image Storage & Delivery)
# ------------------------------------------------------------------------------
# Used for storing and serving menu item images.
BUNNY_ACCESS_KEY=your_bunny_access_key_here
BUNNY_STORAGE_ZONE=your_storage_zone_here
BUNNY_CDN_HOSTNAME=your_cdn_hostname_here

# ------------------------------------------------------------------------------
# 8. Google SSO/Authentication Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here

